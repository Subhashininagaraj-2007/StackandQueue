class Solution {
    static boolean isBalanced(String s) {
Stack<Character> c = new Stack<>();

        for (int i = 0; i < s.length(); i++) {
            char a = s.charAt(i);

            if (a == '{' || a == '[' || a == '(') {
                c.push(a);
            } else if (a == '}' || a == ']' || a == ')') {
                // Check if stack is empty before popping
                if (c.isEmpty()) return false;

                char top = c.pop();

                if ((a == ']' && top != '[') ||
                    (a == '}' && top != '{') ||
                    (a == ')' && top != '(')) {
                    return false;
                }
            }
        }

        return c.isEmpty();
    }
}
